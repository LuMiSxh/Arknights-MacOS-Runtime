+    case SIO_ADDRESS_LIST_SORT:
+    {
+        SOCKET_ADDRESS_LIST *in = in_buff, *out = out_buff;
+        const DWORD header_size = FIELD_OFFSET(SOCKET_ADDRESS_LIST, Address[0]);
+        DWORD list_size, total, offset, ret;
+        struct afd_complete_async_params complete = {STATUS_SUCCESS, 0};
+        int i;
+
+        TRACE("-> SIO_ADDRESS_LIST_SORT request\n");
+
+        if (!lmisxh_akmocl_winsock_enabled())
+        {
+            *ret_size = 0;
+            SetLastError( WSAEOPNOTSUPP );
+            return -1;
+        }
+        if (!in || in_size < header_size || in->iAddressCount < 0)
+        {
+            *ret_size = 0;
+            SetLastError( WSAEINVAL );
+            return -1;
+        }
+        /* Bound the count before multiplying or reading the address array. */
+        if ((DWORD)in->iAddressCount > (in_size - header_size) / sizeof(in->Address[0]))
+        {
+            *ret_size = 0;
+            SetLastError( WSAEFAULT );
+            return -1;
+        }
+        list_size = header_size + in->iAddressCount * sizeof(in->Address[0]);
+        total = list_size;
+        for (i = 0; i < in->iAddressCount; i++)
+        {
+            const SOCKET_ADDRESS *address = &in->Address[i];
+
+            if (!address->lpSockaddr || address->iSockaddrLength <= 0 ||
+                (DWORD)address->iSockaddrLength > MAXDWORD - total)
+            {
+                *ret_size = 0;
+                SetLastError( WSAEINVAL );
+                return -1;
+            }
+            total += address->iSockaddrLength;
+        }
+        /* The in-place path keeps the original layout, including its padding. */
+        if (out == in) total = max(total, in_size);
+        if (!out || out_size < total)
+        {
+            *ret_size = total;
+            SetLastError( WSAEFAULT );
+            return -1;
+        }
+
+        /* Compatibility fallback: preserve the supplied address order. */
+        if (out != in)
+        {
+            memcpy( out, in, list_size );
+            offset = list_size;
+            for (i = 0; i < in->iAddressCount; i++)
+            {
+                SOCKET_ADDRESS *address = &out->Address[i];
+
+                memmove( (char *)out + offset, address->lpSockaddr, address->iSockaddrLength );
+                address->lpSockaddr = (SOCKADDR *)((char *)out + offset);
+                offset += address->iSockaddrLength;
+            }
+        }
+        complete.output_size = total;
+        ret = server_ioctl_sock( s, IOCTL_AFD_WINE_COMPLETE_ASYNC, &complete, sizeof(complete),
+                                 NULL, 0, ret_size, overlapped, completion );
+        *ret_size = total;
+        SetLastError( ret );
+        return ret ? -1 : 0;
+    }
