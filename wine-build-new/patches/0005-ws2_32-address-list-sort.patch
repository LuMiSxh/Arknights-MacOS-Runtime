+++ b/dlls/ws2_32/socket.c
@@ -24,8 +24,25 @@
 #include "ws2_32_private.h"

+#include <stdlib.h>
+
 #define FILE_USE_FILE_POINTER_POSITION ((LONGLONG)-2)

 WINE_DEFAULT_DEBUG_CHANNEL(winsock);
 WINE_DECLARE_DEBUG_CHANNEL(winediag);

+static BOOL lmisxh_akmocl_winsock_enabled(void)
+{
+    static LONG state = -1;
+    LONG value = state;
+
+    if (value == -1)
+    {
+        const char *flag = getenv( "LMISXH_AKMOCL_WINSOCK" );
+
+        value = !flag || (flag[0] == '1' && !flag[1]);
+        InterlockedCompareExchange( &state, value, -1 );
+    }
+    return value;
+}
+
 #define TIMEOUT_INFINITE _I64_MAX
@@ -2767,6 +2767,77 @@ INT WINAPI WSAIoctl(SOCKET s, DWORD code, LPVOID in_buff, DWORD in_size, LPVOID
         return ret ? -1 : 0;
     }

+    case SIO_ADDRESS_LIST_SORT:
+    {
+        SOCKET_ADDRESS_LIST *in = in_buff, *out = out_buff;
+        DWORD list_size, total;
+        int i;
+
+        TRACE("-> SIO_ADDRESS_LIST_SORT request\n");
+
+        if (!lmisxh_akmocl_winsock_enabled())
+        {
+            *ret_size = 0;
+            SetLastError( WSAEOPNOTSUPP );
+            return -1;
+        }
+
+        if (!in || in_size < FIELD_OFFSET(SOCKET_ADDRESS_LIST, Address[0]) ||
+            in->iAddressCount < 0)
+        {
+            *ret_size = 0;
+            SetLastError( WSAEINVAL );
+            return -1;
+        }
+        list_size = FIELD_OFFSET(SOCKET_ADDRESS_LIST, Address[in->iAddressCount]);
+        if (in_size < list_size)
+        {
+            *ret_size = list_size;
+            SetLastError( WSAEFAULT );
+            return -1;
+        }
+        if (!out || out_size < list_size)
+        {
+            *ret_size = list_size;
+            SetLastError( WSAEFAULT );
+            return -1;
+        }
+
+        /* Windows orders the list with the RFC 6724 destination algorithm, which needs
+         * the source addresses.  Callers such as Chromium's asynchronous DNS resolver
+         * only need a valid list, so keep the supplied order. */
+        if (out == in)
+        {
+            *ret_size = in_size;
+            return 0;
+        }
+
+        memcpy( out, in, list_size );
+        total = list_size;
+        for (i = 0; i < in->iAddressCount; i++)
+        {
+            SOCKET_ADDRESS *address = &out->Address[i];
+
+            if (!address->lpSockaddr || address->iSockaddrLength <= 0)
+            {
+                *ret_size = 0;
+                SetLastError( WSAEINVAL );
+                return -1;
+            }
+            if (total + address->iSockaddrLength > out_size)
+            {
+                *ret_size = total + address->iSockaddrLength;
+                SetLastError( WSAEFAULT );
+                return -1;
+            }
+            memmove( (char *)out + total, address->lpSockaddr, address->iSockaddrLength );
+            address->lpSockaddr = (SOCKADDR *)((char *)out + total);
+            total += address->iSockaddrLength;
+        }
+        *ret_size = total;
+        return 0;
+    }
+
