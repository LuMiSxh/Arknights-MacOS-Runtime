+static BOOL is_bilibili_payment_proxy_window(HWND hwnd, HWND parent)
+{
+    static const WCHAR browserW[] = {'C','e','f','B','r','o','w','s','e','r','W','i','n','d','o','w',0};
+    static const WCHAR payment_rootW[] = {'C','P','a','y','D','l','g','_','P','_',0};
+    WCHAR parent_class[MAX_ATOM_LEN] = {0}, root_class[MAX_ATOM_LEN] = {0};
+    UNICODE_STRING parent_name = {.Buffer = parent_class, .MaximumLength = sizeof(parent_class)};
+    UNICODE_STRING root_name = {.Buffer = root_class, .MaximumLength = sizeof(root_class)};
+    HWND root;
+    DWORD hwnd_pid = 0, parent_pid = 0, root_pid = 0;
+    INT root_length;
+
+    if (!parent || NtUserGetAncestor(hwnd, GA_PARENT) != parent ||
+        (NtUserGetWindowLongW(hwnd, GWL_STYLE) & (WS_CHILD | WS_POPUP)) != WS_CHILD)
+        return FALSE;
+    if (NtUserGetClassName(parent, FALSE, &parent_name) != ARRAY_SIZE(browserW) - 1 ||
+        wcscmp(parent_class, browserW))
+        return FALSE;
+
+    /* GA_ROOT follows parent links only; owner relationships are not part of this route. */
+    if (!(root = NtUserGetAncestor(hwnd, GA_ROOT)) ||
+        (NtUserGetWindowLongW(root, GWL_STYLE) & WS_CHILD))
+        return FALSE;
+    if (!(root_length = NtUserGetClassName(root, FALSE, &root_name)) ||
+        root_length <= ARRAY_SIZE(payment_rootW) - 1 ||
+        wcsncmp(root_class, payment_rootW, ARRAY_SIZE(payment_rootW) - 1))
+        return FALSE;
+
+    NtUserGetWindowThread(hwnd, &hwnd_pid);
+    NtUserGetWindowThread(parent, &parent_pid);
+    NtUserGetWindowThread(root, &root_pid);
+    return hwnd_pid && hwnd_pid == parent_pid && hwnd_pid == root_pid;
+}
+
+BOOL macdrv_is_bilibili_layered_child(HWND hwnd)
+{
+    static const WCHAR chrome_widgetW[] = {'C','h','r','o','m','e','_','W','i','d','g','e','t','W','i','n','_','0',0};
+    static const WCHAR translucentW[] = {'C','h','r','o','m','e','.','W','i','n','d','o','w','T','r','a','n','s','l','u','c','e','n','t',0};
+    WCHAR class[MAX_ATOM_LEN] = {0};
+    UNICODE_STRING name = {.Buffer = class, .MaximumLength = sizeof(class)};
+
+    if (!arknights_runtime_cn_compat_enabled() || !running_image_is("PCGamePlatform.exe") ||
+        !NtUserGetProp(hwnd, translucentW) || !NtUserGetClassName(hwnd, FALSE, &name) ||
+        wcscmp(class, chrome_widgetW))
+        return FALSE;
+    {
+        HWND parent = NtUserGetAncestor(hwnd, GA_PARENT);
+        return has_bilibili_webview_ancestor(parent) || is_bilibili_payment_proxy_window(hwnd, parent);
+    }
+}
+
+static BOOL get_hosted_rects(HWND hwnd, HWND toplevel, RECT *container, RECT *frame)
+{
+    UINT dpi = NtUserGetWinMonitorDpi(hwnd, MDT_DEFAULT);
+    POINT points[2];
+    RECT rect;
+
+    if (!NtUserGetWindowRect(hwnd, &rect, dpi)) return FALSE;
+    points[0].x = rect.left;
+    points[0].y = rect.top;
+    points[1].x = rect.right;
+    points[1].y = rect.bottom;
+    if (NtUserMapWindowPoints(NULL, toplevel, points, 2, dpi)) return FALSE;
+
+    frame->left = points[0].x;
+    frame->top = points[0].y;
+    frame->right = points[1].x;
+    frame->bottom = points[1].y;
+    if (container && !NtUserGetClientRect(toplevel, container, dpi)) return FALSE;
+    return TRUE;
+}
+
+static BOOL sync_layered_child_view(HWND hwnd, WineContentView *view)
+{
+    HWND toplevel = NtUserGetAncestor(hwnd, GA_ROOT);
+    RECT container, frame;
+    struct macdrv_win_data *data;
+    WineWindow *window;
+
+    if (!view) return FALSE;
+    if (!macdrv_is_bilibili_layered_child(hwnd) || !toplevel ||
+        !(data = get_win_data(toplevel)))
+    {
+        macdrv_set_view_hidden(view, TRUE);
+        return FALSE;
+    }
+    window = data->cocoa_window;
+    if (!window || !get_hosted_rects(hwnd, toplevel, &container, &frame))
+    {
+        release_win_data(data);
+        macdrv_set_view_hidden(view, TRUE);
+        return FALSE;
+    }
+
+    macdrv_set_view_superview(view, NULL, window, NULL, NULL);
+    macdrv_set_view_frame(view, cgrect_from_rect(frame));
+    macdrv_set_view_hidden(view, !NtUserIsWindowVisible(hwnd));
+    release_win_data(data);
+    return TRUE;
+}
+
+BOOL macdrv_attach_layered_child_view(HWND hwnd, WineContentView *view)
+{
+    struct macdrv_win_data *data;
+
+    if (!view || !macdrv_is_bilibili_layered_child(hwnd)) return FALSE;
+    if (!sync_layered_child_view(hwnd, view)) return FALSE;
+
+    if (!(data = get_win_data(hwnd))) return FALSE;
+    data->layered_view = view;
+    release_win_data(data);
+    return TRUE;
+}
+
+void macdrv_detach_layered_child_view(HWND hwnd, WineContentView *view)
+{
+    struct macdrv_win_data *data;
+
+    if (!(data = get_win_data(hwnd))) return;
+    if (data->layered_view == view) data->layered_view = NULL;
+    release_win_data(data);
+}
