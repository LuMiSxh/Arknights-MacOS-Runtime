+static BOOL arknights_runtime_cn_compat_enabled(void)
+{
+    static LONG state = -1;
+    LONG value = state;
+    const char *master, *flag;
+
+    if (value == -1)
+    {
+        master = getenv("LMISXH_AKMOCL"); flag = getenv("LMISXH_AKMOCL_CN");
+        value = master && master[0] == '1' && !master[1] && flag && flag[0] == '1' && !flag[1];
+        InterlockedCompareExchange(&state, value, -1);
+    }
+    return value;
+}
