+void macdrv_view_set_io_surface(WineContentView *view, IOSurfaceRef s, CGRect rect, CGRect dirty)
+{
+@autoreleasepool
+{
+    IOSurface *surface = (IOSurface *)s;
+
+    [view retain];
+    [surface retain];
+    OnMainThreadAsync(^{
+        [view setIOSurface:surface];
+        [view setSurfaceRect:cgrect_mac_from_win(rect)];
+        [view setNeedsDisplayInRect:NSRectFromCGRect(cgrect_mac_from_win(dirty))];
+        [surface release];
+        [view release];
