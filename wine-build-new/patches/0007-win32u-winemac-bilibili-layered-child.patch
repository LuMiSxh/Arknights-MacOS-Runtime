+static BOOL running_image_is(const char *exe_name)
+{
+    const UNICODE_STRING *image = &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
+    const WCHAR *p, *start;
+    WCHAR expected[64];
+    unsigned int i;
+
+    if (!image->Buffer) return FALSE;
+
+    for (start = p = image->Buffer; *p; p++)
+        if (*p == '\\' || *p == '/') start = p + 1;
+
+    for (i = 0; exe_name[i] && i < ARRAY_SIZE(expected) - 1; i++) expected[i] = exe_name[i];
+    expected[i] = 0;
+    if (exe_name[i]) return FALSE;
+
+    return !wcsicmp(start, expected);
+}
+
+static BOOL arknights_runtime_cn_compat_enabled(void)
+{
+    const char *master = getenv("LMISXH_AKMOCL"), *flag = getenv("LMISXH_AKMOCL_CN");
+
+    return master && master[0] == '1' && !master[1] && flag && flag[0] == '1' && !flag[1];
+}
+
+static BOOL command_line_has_cef_type(void)
+{
+    const UNICODE_STRING *command_line = &NtCurrentTeb()->Peb->ProcessParameters->CommandLine;
+    static const WCHAR typeW[] = {'-','-','t','y','p','e','=',0};
+    unsigned int length, i;
+
+    if (!command_line->Buffer) return FALSE;
+
+    length = command_line->Length / sizeof(WCHAR);
+    for (i = 0; i + ARRAY_SIZE(typeW) - 1 <= length; i++)
+        if (!wcsnicmp(command_line->Buffer + i, typeW, ARRAY_SIZE(typeW) - 1)) return TRUE;
+
+    return FALSE;
+}
+
+bool macdrv_is_bilibili_platform_process(void)
+{
+    static LONG state = -1;
+    bool enabled = false;
+
+    if (state != -1) return state;
+
+    if (arknights_runtime_cn_compat_enabled() && running_image_is("PCGamePlatform.exe") &&
+        !command_line_has_cef_type())
+        enabled = true;
+
+    InterlockedCompareExchange(&state, enabled, -1);
+    return enabled;
+}
+
+static BOOL has_bilibili_webview_ancestor(HWND hwnd)
+{
+    static const WCHAR webviewW[] = {'C','M','y','W','e','b','V','i','e','w','D','l','g',0};
+    WCHAR class_name[MAX_ATOM_LEN] = {0};
+    UNICODE_STRING name = {.Buffer = class_name, .MaximumLength = sizeof(class_name)};
+
+    while (hwnd)
+    {
+        if (NtUserGetClassName(hwnd, FALSE, &name) && !wcscmp(class_name, webviewW)) return TRUE;
+        hwnd = NtUserGetAncestor(hwnd, GA_PARENT);
+    }
+    return FALSE;
+}
