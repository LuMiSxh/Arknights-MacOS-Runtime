+static inline BOOL lmisxh_akmocl_flag( const char *name )
+{
+    WCHAR nameW[32];
+    WCHAR valueW[2];
+    UNICODE_STRING nameU, valueU;
+    NTSTATUS status;
+    unsigned int i;
+
+    for (i = 0; name[i] && i < sizeof(nameW) / sizeof(nameW[0]) - 1; i++)
+        nameW[i] = (unsigned char)name[i];
+    nameW[i] = 0;
+
+    nameU.Length = i * sizeof(WCHAR);
+    nameU.MaximumLength = (i + 1) * sizeof(WCHAR);
+    nameU.Buffer = nameW;
+    valueU.Length = 0;
+    valueU.MaximumLength = sizeof(valueW);
+    valueU.Buffer = valueW;
+
+    status = RtlQueryEnvironmentVariable_U( NULL, &nameU, &valueU );
+    return status == STATUS_VARIABLE_NOT_FOUND ||
+           (status == STATUS_SUCCESS && valueU.Length == sizeof(WCHAR) && valueW[0] == '1');
+}
+
+static inline BOOL lmisxh_akmocl_eflags_enabled(void)
+{
+    static LONG state = -1;
+    LONG value = state;
+
+    if (value == -1)
+    {
+        PEB *peb = NtCurrentTeb()->Peb;
+
+        /* The environment and its lock are not initialized during the early
+           thread-context conversion path. Use the default until they are, so
+           the lookup never takes the PEB lock before it exists. */
+        if (!peb || !peb->ProcessParameters)
+            return TRUE;
+
+        value = lmisxh_akmocl_flag( "LMISXH_AKMOCL_EFLAGS" );
+        InterlockedCompareExchange( &state, value, -1 );
+    }
+    return value;
+}
+
 static inline UINT eflags_to_cpsr( UINT eflags )
 {
     UINT ret = 0;
@@ -62,6 +108,13 @@ static inline UINT eflags_to_cpsr( UINT eflags )
     if (eflags & 0x0080) ret |= 0x80000000;  /* negative */
     if (eflags & 0x0100) ret |= 0x00200000;  /* trap */
     if (eflags & 0x0800) ret |= 0x10000000;  /* overflow */
+    if (lmisxh_akmocl_eflags_enabled())
+    {
+        /* Match FEX packet bits PF/AF/DF = 26/27/19; never apply these bits to native PSTATE. */
+        if (eflags & 0x0004) ret |= 0x04000000;  /* parity */
+        if (eflags & 0x0010) ret |= 0x08000000;  /* auxiliary carry */
+        if (eflags & 0x0400) ret |= 0x00080000;  /* direction */
+    }
     return ret;
 }

@@ -74,5 +127,11 @@ static inline UINT cpsr_to_eflags( UINT cpsr )
     if (cpsr & 0x20000000) ret |= 0x0001;  /* carry */
     if (cpsr & 0x40000000) ret |= 0x0040;  /* zero */
     if (cpsr & 0x80000000) ret |= 0x0080;  /* negative */
+    if (lmisxh_akmocl_eflags_enabled())
+    {
+        if (cpsr & 0x04000000) ret |= 0x0004;  /* parity */
+        if (cpsr & 0x08000000) ret |= 0x0010;  /* auxiliary carry */
+        if (cpsr & 0x00080000) ret |= 0x0400;  /* direction */
+    }
     return ret;
 }
