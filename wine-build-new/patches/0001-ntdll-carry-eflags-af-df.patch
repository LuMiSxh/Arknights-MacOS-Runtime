diff --git a/dlls/ntdll/unwind.h b/dlls/ntdll/unwind.h
index 1852708..a57a081 100644
--- a/dlls/ntdll/unwind.h
+++ b/dlls/ntdll/unwind.h
@@ -24,7 +24,8 @@
 #include <stdarg.h>
 #include "windef.h"
 #include "winbase.h"
 #include "winnt.h"
+#include "winternl.h"

 #if defined(__aarch64__) || defined(__arm64ec__)

@@ -52,6 +53,41 @@ static inline ULONG ctx_flags_arm_to_x64( ULONG flags )
     return ret;
 }

+static inline BOOL lmisxh_akmocl_flag( const char *name )
+{
+    WCHAR nameW[32];
+    WCHAR valueW[2];
+    UNICODE_STRING nameU, valueU;
+    unsigned int i;
+
+    for (i = 0; name[i] && i < sizeof(nameW) / sizeof(nameW[0]) - 1; i++)
+        nameW[i] = (unsigned char)name[i];
+    nameW[i] = 0;
+
+    nameU.Length = i * sizeof(WCHAR);
+    nameU.MaximumLength = (i + 1) * sizeof(WCHAR);
+    nameU.Buffer = nameW;
+    valueU.Length = 0;
+    valueU.MaximumLength = sizeof(valueW);
+    valueU.Buffer = valueW;
+
+    return RtlQueryEnvironmentVariable_U( NULL, &nameU, &valueU ) == STATUS_SUCCESS &&
+           valueU.Length == sizeof(WCHAR) && valueW[0] == '1';
+}
+
+static inline BOOL lmisxh_akmocl_eflags_enabled(void)
+{
+    static LONG state = -1;
+    LONG value = state;
+
+    if (value == -1)
+    {
+        value = lmisxh_akmocl_flag( "LMISXH_AKMOCL_EFLAGS" );
+        InterlockedCompareExchange( &state, value, -1 );
+    }
+    return value;
+}
+
 static inline UINT eflags_to_cpsr( UINT eflags )
 {
     UINT ret = 0;
@@ -62,6 +77,12 @@ static inline UINT eflags_to_cpsr( UINT eflags )
     if (eflags & 0x0080) ret |= 0x80000000;  /* negative */
     if (eflags & 0x0100) ret |= 0x00200000;  /* trap */
     if (eflags & 0x0800) ret |= 0x10000000;  /* overflow */
+    if (lmisxh_akmocl_eflags_enabled())
+    {
+        /* not representable in NZCV: kept in RES0 bits, which never reach the hardware PSTATE */
+        if (eflags & 0x0010) ret |= 0x00020000;  /* auxiliary carry */
+        if (eflags & 0x0400) ret |= 0x00010000;  /* direction */
+    }
     return ret;
 }

@@ -74,5 +94,10 @@ static inline UINT cpsr_to_eflags( UINT cpsr )
     if (cpsr & 0x20000000) ret |= 0x0001;  /* carry */
     if (cpsr & 0x40000000) ret |= 0x0040;  /* zero */
     if (cpsr & 0x80000000) ret |= 0x0080;  /* negative */
+    if (lmisxh_akmocl_eflags_enabled())
+    {
+        if (cpsr & 0x00020000) ret |= 0x0010;  /* auxiliary carry */
+        if (cpsr & 0x00010000) ret |= 0x0400;  /* direction */
+    }
     return ret;
 }
