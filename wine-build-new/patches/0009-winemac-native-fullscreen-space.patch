+/* Case-insensitive match of the program's file name against an ASCII name. */
+static BOOL image_name_is(const WCHAR *image, const char *name)
+{
+    for (; *image && *name; image++, name++)
+    {
+        WCHAR left = *image, right = (unsigned char)*name;
