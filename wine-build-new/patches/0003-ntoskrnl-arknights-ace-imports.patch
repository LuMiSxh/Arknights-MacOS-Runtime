+/*********************************************************************
+ *           SeSetAuditParameter    (NTOSKRNL.@)
+ */
+NTSTATUS WINAPI SeSetAuditParameter(void *audit_parameters, LONG type, ULONG index, void *data)
+{
+    if (!lmisxh_akmocl_ace_imports_enabled()) return STATUS_NOT_IMPLEMENTED;
+    FIXME("%p %ld %lu %p\n", audit_parameters, type, index, data);
+    return STATUS_SUCCESS;
+}
