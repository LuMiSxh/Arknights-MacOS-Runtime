+static BOOL lmisxh_akmocl_flag( const char *name )
+{
+    WCHAR nameW[32];
+    WCHAR valueW[2];
+    UNICODE_STRING nameU, valueU;
+    NTSTATUS status;
+    unsigned int i;
+
+    for (i = 0; name[i] && i < sizeof(nameW) / sizeof(nameW[0]) - 1; i++)
+        nameW[i] = (unsigned char)name[i];
+    nameW[i] = 0;
+
+    nameU.Length = i * sizeof(WCHAR);
+    nameU.MaximumLength = (i + 1) * sizeof(WCHAR);
+    nameU.Buffer = nameW;
+    valueU.Length = 0;
+    valueU.MaximumLength = sizeof(valueW);
+    valueU.Buffer = valueW;
+
+    status = RtlQueryEnvironmentVariable_U( NULL, &nameU, &valueU );
+    return status == STATUS_VARIABLE_NOT_FOUND ||
+           (status == STATUS_SUCCESS && valueU.Length == sizeof(WCHAR) && valueW[0] == '1');
+}
+
+static BOOL lmisxh_akmocl_ace_imports_enabled(void)
+{
+    static LONG state = -1;
+    LONG value = state;
+
+    if (value == -1)
+    {
+        value = lmisxh_akmocl_flag( "LMISXH_AKMOCL_ACE_IMPORTS" );
+        InterlockedCompareExchange( &state, value, -1 );
+    }
+    return value;
+}
+
+/***********************************************************************
+ *           PsGetCurrentThreadProcess   (NTOSKRNL.EXE.@)
+ */
+PEPROCESS WINAPI PsGetCurrentThreadProcess(void)
+{
+    if (!lmisxh_akmocl_ace_imports_enabled()) return NULL;
+    return PsGetCurrentProcess();
+}
+
+/***********************************************************************
+ *           PsGetCurrentThreadProcessId   (NTOSKRNL.EXE.@)
+ */
+HANDLE WINAPI PsGetCurrentThreadProcessId(void)
+{
+    if (!lmisxh_akmocl_ace_imports_enabled()) return 0;
+    return PsGetCurrentProcessId();
+}
+
