+static BOOL lmisxh_akmocl_ace_imports_enabled(void)
+{
+    static LONG state = -1;
+    LONG value = state;
+
+    if (value == -1)
+    {
+        const char *flag = getenv( "LMISXH_AKMOCL_ACE_IMPORTS" );
+
+        value = !flag || (flag[0] == '1' && !flag[1]);
+        InterlockedCompareExchange( &state, value, -1 );
+    }
+    return value;
+}
+
+/***********************************************************************
+ *           PsGetCurrentThreadProcess   (NTOSKRNL.EXE.@)
+ */
+PEPROCESS WINAPI PsGetCurrentThreadProcess(void)
+{
+    if (!lmisxh_akmocl_ace_imports_enabled()) return NULL;
+    return PsGetCurrentProcess();
+}
+
+/***********************************************************************
+ *           PsGetCurrentThreadProcessId   (NTOSKRNL.EXE.@)
+ */
+HANDLE WINAPI PsGetCurrentThreadProcessId(void)
+{
+    if (!lmisxh_akmocl_ace_imports_enabled()) return 0;
+    return PsGetCurrentProcessId();
+}
+
 /***********************************************************************
