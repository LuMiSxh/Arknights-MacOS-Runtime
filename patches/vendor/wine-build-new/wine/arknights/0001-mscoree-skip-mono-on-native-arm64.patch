@@ -845,6 +845,21 @@ static BOOL get_support_msi(LPCWSTR mono_path, LPWSTR msi_path)
 
 static BOOL install_wine_mono(void)
 {
+#if defined(__aarch64__)
+    /* macOS keeps the low 4 GB unmapped without the cross-architecture entitlement.
+     * The Wine Mono support package needs 32-bit installers, so the Arknights
+     * ARM64 lane skips it. */
+    char enabled[2];
+
+    if (GetEnvironmentVariableA( "LMISXH_AKMOCL", enabled, sizeof(enabled) ) == 1 &&
+        enabled[0] == '1' &&
+        GetEnvironmentVariableA( "LMISXH_AKMOCL_MONO", enabled, sizeof(enabled) ) == 1 &&
+        enabled[0] == '1')
+    {
+        WARN( "not installing Wine Mono in the Arknights ARM64 runtime\n" );
+        return TRUE;
+    }
+#endif
     BOOL is_wow64 = FALSE;
     HMODULE hmsi = NULL;
     HRESULT initresult = E_FAIL;
