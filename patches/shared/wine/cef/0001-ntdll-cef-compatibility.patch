 #if defined(__i386__) || defined(__x86_64__)
+#ifdef __x86_64__
+/* CEF compatibility is opt-in and descriptor-driven. Explicit
+ * ARKNIGHTS_RUNTIME_CEF_COMPAT=1 enables every regional descriptor;
+ * ARKNIGHTS_RUNTIME_CN_COMPAT=1 remains a legacy fallback for the proven
+ * Bilibili descriptor when CEF_COMPAT is absent. */
+enum arknights_cef_compat_mode
+{
+    ARKNIGHTS_CEF_COMPAT_DISABLED,
+    ARKNIGHTS_CEF_COMPAT_GENERIC,
+    ARKNIGHTS_CEF_COMPAT_LEGACY_CN
+};
+
+enum arknights_cef_descriptor_region
+{
+    ARKNIGHTS_CEF_REGION_CN
+};
+
+static const WCHAR arknights_runtime_cef_compat_nameW[] =
+    {'A','R','K','N','I','G','H','T','S','_','R','U','N','T','I','M','E','_','C','E','F','_','C','O','M','P','A','T',0};
+static const WCHAR arknights_runtime_cn_compat_nameW[] =
+    {'A','R','K','N','I','G','H','T','S','_','R','U','N','T','I','M','E','_','C','N','_','C','O','M','P','A','T',0};
+
+static BOOL arknights_runtime_query_flag( const WCHAR *name, USHORT name_length, BOOL *present )
+{
+    WCHAR flag[2] = {0};
+    UNICODE_STRING nameW = {name_length, name_length + sizeof(WCHAR), (WCHAR *)name};
+    UNICODE_STRING valueW = {0, sizeof(flag), flag};
+    NTSTATUS status = RtlQueryEnvironmentVariable_U( NULL, &nameW, &valueW );
+
+    *present = status != STATUS_VARIABLE_NOT_FOUND;
+    return status == STATUS_SUCCESS && valueW.Length == sizeof(WCHAR) && flag[0] == '1';
+}
+
+static enum arknights_cef_compat_mode arknights_runtime_cef_compat_mode(void)
+{
+    static LONG state = -1;
+    LONG value = state;
+    BOOL present;
+
+    if (value == -1)
+    {
+        if (arknights_runtime_query_flag( arknights_runtime_cef_compat_nameW,
+                                          sizeof(arknights_runtime_cef_compat_nameW) - sizeof(WCHAR), &present ))
+            value = ARKNIGHTS_CEF_COMPAT_GENERIC;
+        else if (present)
+            value = ARKNIGHTS_CEF_COMPAT_DISABLED;
+        else if (arknights_runtime_query_flag( arknights_runtime_cn_compat_nameW,
+                                               sizeof(arknights_runtime_cn_compat_nameW) - sizeof(WCHAR), &present ))
+            value = ARKNIGHTS_CEF_COMPAT_LEGACY_CN;
+        else
+            value = ARKNIGHTS_CEF_COMPAT_DISABLED;
+        InterlockedCompareExchange(&state, value, -1);
+    }
+    return value;
+}
+
+struct arknights_cef_patch
+{
+    ULONG_PTR offset;
+    const char *before;
+    const char *after;
+    SIZE_T size;
+};
+
+struct arknights_cef_descriptor
+{
+    const WCHAR *module_name;
+    const struct arknights_cef_patch *patches;
+    unsigned int patch_count;
+    enum arknights_cef_descriptor_region region;
+};
+
+static BOOL arknights_apply_cef_descriptor( WINE_MODREF *wm,
+                                            const struct arknights_cef_descriptor *descriptor,
+                                            enum arknights_cef_compat_mode mode )
+{
+    unsigned int i;
+
+    if (mode == ARKNIGHTS_CEF_COMPAT_DISABLED ||
+        (mode == ARKNIGHTS_CEF_COMPAT_LEGACY_CN && descriptor->region != ARKNIGHTS_CEF_REGION_CN) ||
+        wcscmp( wm->ldr.BaseDllName.Buffer, descriptor->module_name ))
+        return FALSE;
+
+    /* Preflight all expected bytes before writing any patch bytes. */
+    for (i = 0; i < descriptor->patch_count; i++)
+    {
+        void *target;
+
+        if (descriptor->patches[i].offset > wm->ldr.SizeOfImage ||
+            descriptor->patches[i].size > wm->ldr.SizeOfImage - descriptor->patches[i].offset)
+            return FALSE;
+        target = (char *)wm->ldr.DllBase + descriptor->patches[i].offset;
+        if (memcmp( target, descriptor->patches[i].before, descriptor->patches[i].size ))
+            return FALSE;
+    }
+
+    for (i = 0; i < descriptor->patch_count; i++)
+    {
+        DWORD old_prot;
+        SIZE_T pagesize = page_size;
+        void *target = (char *)wm->ldr.DllBase + descriptor->patches[i].offset;
+        void *target_page = (void *)((ULONG_PTR)target & ~(page_size - 1));
+
+        if (NtProtectVirtualMemory( NtCurrentProcess(), &target_page, &pagesize,
+                                    PAGE_EXECUTE_READWRITE, &old_prot ))
+            return FALSE;
+        memcpy( target, descriptor->patches[i].after, descriptor->patches[i].size );
+        NtProtectVirtualMemory( NtCurrentProcess(), &target_page, &pagesize, old_prot, &old_prot );
+    }
+    return TRUE;
+}
+
+/* Bilibili's CEF 80.1.15 descriptor. Keep these hash/RVA/byte-specific
+ * preflights isolated so future regional descriptors cannot broaden this route. */
+static void apply_bilibili_cef80_stackbase_patch( WINE_MODREF *wm )
+{
+    static const WCHAR cef_name[] = {'l','i','b','c','e','f','.','d','l','l',0};
+    static const char before_thunk[] =
+    {
+        0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc,
+        0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc
+    };
+    static const char after_thunk[] =
+    {
+        0x65, 0x48, 0x8b, 0x04, 0x25, 0x30, 0x00, 0x00, 0x00, /* mov rax, qword [gs:0x30] */
+        0x48, 0x8b, 0x40, 0x08,                               /* mov rax, qword [rax+8] */
+        0xc3,                                                   /* ret */
+        0xcc                                                    /* preserve the alignment byte */
+    };
+    C_ASSERT( sizeof(before_thunk) == sizeof(after_thunk) );
+    static const char before_stackbase_pair[] =
+    {
+        0x65, 0x48, 0x8b, 0x04, 0x25, 0x08, 0x00, 0x00, 0x00, /* mov rax, qword [gs:0x8] */
+        0xc3,                                                   /* ret */
+        0x56,                                                   /* push rsi */
+        0x48, 0x83, 0xec, 0x20,                                /* sub rsp, 0x20 */
+        0x65, 0x48, 0x8b, 0x04, 0x25, 0x08, 0x00, 0x00, 0x00, /* mov rax, qword [gs:0x8] */
+        0x48, 0xc7, 0xc6, 0xf8, 0xff, 0xff, 0xff              /* mov rsi, 0xfffffffffffffff8 */
+    };
+    static const char after_stackbase_pair[] =
+    {
+        0xe8, 0x0c, 0x46, 0xff, 0xff, /* call the local thunk */
+        0x90, 0x90, 0x90, 0x90, 0xc3, /* preserve the original return */
+        0x56, 0x48, 0x83, 0xec, 0x20, /* preserve the stack frame */
+        0xe8, 0xfd, 0x45, 0xff, 0xff, /* call the local thunk */
+        0x90, 0x90, 0x90, 0x90,
+        0x48, 0xc7, 0xc6, 0xf8, 0xff, 0xff, 0xff              /* preserve the frame adjustment */
+    };
+    C_ASSERT( sizeof(before_stackbase_pair) == sizeof(after_stackbase_pair) );
+    static const char before_stackbase_check[] =
+    {
+        0x48, 0x8b, 0x46, 0x08,                                 /* mov rax, qword [rsi+8] */
+        0x65, 0x48, 0x8b, 0x34, 0x25, 0x08, 0x00, 0x00, 0x00,   /* mov rsi, qword [gs:0x8] */
+        0x48, 0x85, 0xf6,                                       /* test rsi, rsi */
+        0x74, 0x2e                                             /* je 0x30 */
+    };
+    static const char after_stackbase_check[] =
+    {
+        0x48, 0x8b, 0x46, 0x08,                                 /* mov rax, qword [rsi+8] */
+        0x65, 0x48, 0x8b, 0x34, 0x25, 0x30, 0x00, 0x00, 0x00,   /* mov rsi, qword [gs:0x30] */
+        0x48, 0x8b, 0x76, 0x08,                                 /* mov rsi, qword [rsi+8] */
+        0x90                                                   /* nop */
+    };
+    C_ASSERT( sizeof(before_stackbase_check) == sizeof(after_stackbase_check) );
+    static const struct arknights_cef_patch patches[] =
+    {
+        { 0x24b87f1, before_thunk, after_thunk, sizeof(before_thunk) },
+        /* The second gs:[0x8] instruction starts at RVA 0x24c41ef; RVA
+         * 0x24c41e9 is the ret byte immediately after the first instruction. */
+        { 0x24c41e0, before_stackbase_pair, after_stackbase_pair, sizeof(before_stackbase_pair) },
+        { 0x24c425f, before_stackbase_check, after_stackbase_check, sizeof(before_stackbase_check) }
+    };
+    static const struct arknights_cef_descriptor descriptor =
+        {cef_name, patches, ARRAY_SIZE(patches), ARKNIGHTS_CEF_REGION_CN};
+
+    arknights_apply_cef_descriptor( wm, &descriptor, arknights_runtime_cef_compat_mode() );
+}
+#endif
