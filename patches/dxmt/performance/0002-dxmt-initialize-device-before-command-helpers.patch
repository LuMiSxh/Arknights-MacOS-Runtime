From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arknights MacOS Runtime Maintainers <arknights-macos-runtime@users.noreply.github.com>
Date: Sat, 12 Sep 2026 08:30:00 +0000
Subject: [PATCH] dxmt: initialize the device before command helpers

ClearUAV constructs ten compute pipelines through its outer
ArgumentEncodingContext. That path reads device_ before its member
constructor runs, producing missing pipelines with zero-filled storage
or an invalid Objective-C receiver with reused storage.

Move the device declaration and initializer before the command helpers.
This is an unconditional initialization-correctness prerequisite for the
performance canary, with no runtime flag check or rendering policy change.

---
diff --git a/src/dxmt/dxmt_context.hpp b/src/dxmt/dxmt_context.hpp
--- a/src/dxmt/dxmt_context.hpp
+++ b/src/dxmt/dxmt_context.hpp
@@ -334,6 +334,9 @@
 class ArgumentEncodingContext {
   friend struct SimpleCommandContext<ArgumentEncodingContext>;
 private:
+  // Command helper constructors use this device through the outer context.
+  WMT::Device device_;
+
   template <PipelineStage stage> void track(GenericAccessTracker &tracker, int flags);
 
 public:
@@ -918,7 +921,6 @@
 
   uint64_t intrapass_barrier_control_bits_ = 0;
 
-  WMT::Device device_;
   CommandQueue& queue_;
 };
 
diff --git a/src/dxmt/dxmt_context.cpp b/src/dxmt/dxmt_context.cpp
--- a/src/dxmt/dxmt_context.cpp
+++ b/src/dxmt/dxmt_context.cpp
@@ -30,6 +30,7 @@
 namespace dxmt {
 
 ArgumentEncodingContext::ArgumentEncodingContext(CommandQueue &queue, WMT::Device device, InternalCommandLibrary &lib) :
+    device_(device),
     lib(lib),
     emulated_cmd(device, lib, *this),
     clear_rt_cmd(device, lib, *this),
@@ -38,7 +39,6 @@
     mv_scale_cmd(device, lib, *this),
     tile_barrier_cmd(device, lib, *this),
     timestamp_state_(device),
-    device_(device),
     queue_(queue) {
   dummy_sampler_info_.support_argument_buffers = true;
   dummy_sampler_info_.border_color = WMTSamplerBorderColorTransparentBlack;
