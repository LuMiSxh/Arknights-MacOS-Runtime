+ *           init_user_space_floor
+ *
+ * dyld reserves the main executable's Mach-O region starting at 4G.  The
+ * reservation covers unmapped holes too, so mach_vm_map() rejects the whole
+ * range without reporting a region.  Probe upward for the first page that can
+ * actually be mapped and use it as the floor for 64-bit allocations.
+ */
+static void init_user_space_floor(void)
+{
+    char *addr;
+
+    for (addr = (char *)limit_4g; (ULONG_PTR)addr < limit_4g + 0x80000000; addr += 0x100000)
+    {
+        if (anon_mmap_tryfixed( addr, host_page_size, PROT_NONE, 0 ) != MAP_FAILED)
+        {
+            user_space_floor = (ULONG_PTR)addr + host_page_size;
+            TRACE( "user space floor: %p\n", (void *)user_space_floor );
+            return;
+        }
+    }
