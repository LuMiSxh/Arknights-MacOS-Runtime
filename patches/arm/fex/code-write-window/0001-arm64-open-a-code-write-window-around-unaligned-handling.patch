diff --git a/FEXCore/Source/Interface/Core/SharedCodeBufferManager.h b/FEXCore/Source/Interface/Core/SharedCodeBufferManager.h
--- a/FEXCore/Source/Interface/Core/SharedCodeBufferManager.h
+++ b/FEXCore/Source/Interface/Core/SharedCodeBufferManager.h
@@ -23,6 +23,8 @@ namespace FEXCore::CPU {
 // Optional platform hook. Called with the exact range that is about to be written, so that
 // hosts which cannot map a page writable and executable at once can make it writable first.
 // Null on hosts where the code buffer is already writable.
+// A null address asks the host to open its whole code space, for handlers that patch code
+// and block metadata together.
 FEX_DEFAULT_VISIBILITY extern void (*CodeWriteProtectHook)(void* Address, size_t Size);
 // Paired with CodeWriteProtectHook. Called after code has been written and is about to run.
 FEX_DEFAULT_VISIBILITY extern void (*CodeWriteFlushHook)(void* Address, size_t Size);
