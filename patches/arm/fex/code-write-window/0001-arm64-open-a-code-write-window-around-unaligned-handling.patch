   __builtin___clear_cache(static_cast<char*>(Begin), static_cast<char*>(Begin) + Length);
 }

+// Unaligned atomic handling back-patches the JIT block in place. It rewrites the instruction
+// words and locks the block tail spin lock, so the whole handler needs a code write window.
+// Hosts that cannot keep code pages writable and executable at once would fault on those stores.
+struct CodeWriteScope {
+  CodeWriteScope() {
+    if (FEXCore::CPU::CodeWriteProtectHook) {
+      FEXCore::CPU::CodeWriteProtectHook(nullptr, 0);
+    }
+  }
+  ~CodeWriteScope() {
+    if (FEXCore::CPU::CodeWriteFlushHook) {
+      FEXCore::CPU::CodeWriteFlushHook(nullptr, 0);
+    }
+  }
+};
