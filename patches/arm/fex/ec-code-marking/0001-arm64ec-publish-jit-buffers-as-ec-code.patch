diff --git a/Source/Windows/ARM64EC/Module.cpp b/Source/Windows/ARM64EC/Module.cpp
index 0c9d42d..dbf0ade 100644
--- a/Source/Windows/ARM64EC/Module.cpp
+++ b/Source/Windows/ARM64EC/Module.cpp
@@ -66,6 +66,28 @@ namespace Exception {
 class ECSyscallHandler;
 }
 
+// Wine decides whether NtContinue resumes native ARM64EC code or restarts emulation from
+// PEB->EcCodeBitMap. The JIT buffers hold native code, so publish them as EC code pages.
+// Without this a continuation after a handled fault restarts emulation at a host address.
+static void MarkEcCode(void* Ptr, size_t Size, bool IsEcCode) {
+  auto* Peb = reinterpret_cast<__TEB*>(NtCurrentTeb())->Peb;
+  if (!Peb || !Peb->EcCodeBitMap) {
+    return;
+  }
+
+  constexpr uintptr_t PageSize = 0x1000;
+  auto* Bitmap = static_cast<uint64_t*>(Peb->EcCodeBitMap);
+  const uintptr_t FirstPage = reinterpret_cast<uintptr_t>(Ptr) / PageSize;
+  const uintptr_t LastPage = (reinterpret_cast<uintptr_t>(Ptr) + Size + PageSize - 1) / PageSize;
+  for (uintptr_t Page = FirstPage; Page < LastPage; ++Page) {
+    if (IsEcCode) {
+      Bitmap[Page / 64] |= uint64_t {1} << (Page % 64);
+    } else {
+      Bitmap[Page / 64] &= ~(uint64_t {1} << (Page % 64));
+    }
+  }
+}
+
 namespace FEXCore::CPU {
 extern void (*CodeWriteProtectHook)(void*, size_t);
 extern void (*CodeWriteFlushHook)(void*, size_t);
@@ -625,9 +647,14 @@ NTSTATUS ProcessInit() {
         FEX::Windows::UnixLib::JitWriteProtect(true);
       };
       FEXCore::CPU::CodeBufferAllocHook = [](size_t Size) -> void* {
-        return FEX::Windows::UnixLib::JitAlloc(Size);
+        void* Ptr = FEX::Windows::UnixLib::JitAlloc(Size);
+        if (Ptr) {
+          MarkEcCode(Ptr, Size, true);
+        }
+        return Ptr;
       };
       FEXCore::CPU::CodeBufferFreeHook = [](void* Ptr, size_t Size) {
+        MarkEcCode(Ptr, Size, false);
         FEX::Windows::UnixLib::JitFree(Ptr, Size);
       };
     }
