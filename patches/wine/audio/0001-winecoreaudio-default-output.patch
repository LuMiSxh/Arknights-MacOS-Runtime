+static void install_device_listeners(void)
+{
+    static const WCHAR name[] = {'c','o','r','e','a','u','d','i','o','_','f','o','l','l','o','w',0};
+    DWORD priority = THREAD_PRIORITY_NORMAL;
+    OSStatus sc;
+    CFRunLoopRef null_loop = NULL;
+    UInt32 size = sizeof(follow_previous_run_loop);
+
+    if(create_unix_thread(&follow_thread, name, follow_worker, NULL)){
+        WARN("Failed to create the follow worker thread\n");
+        return;
+    }
+    /* create_unix_thread makes audio threads time-critical; this one only
+     * does housekeeping. Demote it here, ordered after the creator's own
+     * priority set, which doing it in the worker would race against. */
+    NtSetInformationThread(follow_thread, ThreadBasePriority, &priority, sizeof(priority));
+
+    /* Wine processes do not pump a CFRunLoop on the main thread, where the
+     * HAL delivers property notifications by default. Setting the run loop
+     * property to NULL tells the HAL to use its own notification thread.
+     * Without this the listener never fires under Wine. */
+    sc = AudioObjectGetPropertyData(kAudioObjectSystemObject, &follow_run_loop_addr, 0, NULL,
+                                    &size, &follow_previous_run_loop);
+    if(sc == noErr && follow_previous_run_loop) CFRetain(follow_previous_run_loop);
+    else if(sc != noErr) WARN("Reading HAL run loop failed: %x\n", (int)sc);
+
+    sc = AudioObjectSetPropertyData(kAudioObjectSystemObject, &follow_run_loop_addr, 0, NULL,
+                                    sizeof(null_loop), &null_loop);
+    if(sc != noErr)
+        WARN("Setting HAL run loop to NULL failed: %x\n", (int)sc);
+    else
+        follow_run_loop_changed = TRUE;
+
+    sc = AudioObjectAddPropertyListener(kAudioObjectSystemObject, &follow_default_addr,
+                                        devices_changed, NULL);
+    if(sc != noErr)
+        WARN("Adding default-device listener failed: %x\n", (int)sc);
+    else{
+        follow_default_listener = TRUE;
+        TRACE("Default-output-device listener installed\n");
+    }
+
+    sc = AudioObjectAddPropertyListener(kAudioObjectSystemObject, &follow_devices_addr,
+                                        devices_changed, NULL);
+    if(sc != noErr)
+        WARN("Adding device-list listener failed: %x\n", (int)sc);
+    else{
+        follow_devices_listener = TRUE;
+        TRACE("Device-list listener installed\n");
+    }
+
+    follow_ready = follow_run_loop_changed && follow_default_listener && follow_devices_listener;
+    if(!follow_ready) shutdown_device_listeners();
+}
+
+static void shutdown_device_listeners(void)
+{
+    OSStatus sc;
+
+    pthread_mutex_lock(&follow_lock);
+    follow_ready = FALSE;
+    pthread_mutex_unlock(&follow_lock);
+    if(follow_default_listener){
+        sc = AudioObjectRemovePropertyListener(kAudioObjectSystemObject, &follow_default_addr,
+                                               devices_changed, NULL);
+        if(sc != noErr) WARN("Removing default-device listener failed: %x\n", (int)sc);
+        follow_default_listener = FALSE;
+    }
+    if(follow_devices_listener){
+        sc = AudioObjectRemovePropertyListener(kAudioObjectSystemObject, &follow_devices_addr,
+                                               devices_changed, NULL);
+        if(sc != noErr) WARN("Removing device-list listener failed: %x\n", (int)sc);
+        follow_devices_listener = FALSE;
+    }
+
+    pthread_mutex_lock(&follow_signal_lock);
+    follow_stopping = TRUE;
+    pthread_cond_broadcast(&follow_signal_cond);
+    pthread_mutex_unlock(&follow_signal_lock);
