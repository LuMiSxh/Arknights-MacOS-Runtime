+/* The QPC relative-wait variant is on by default. Unset or "1" keeps it; any
+ * other value falls back to the upstream wall-clock implementation. */
+static BOOL lmisxh_akmocl_ace_timing_enabled(void)
+{
+    static LONG state = -1;
+    LONG value = state;
