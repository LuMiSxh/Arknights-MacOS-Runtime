+    if (value == -1)
+    {
+        const char *flag = getenv("LMISXH_AKMOCL_ACE_TIMING");
+        value = !flag || (flag[0] == '1' && flag[1] == '\0');
+        InterlockedCompareExchange(&state, value, -1);
+    }
+    return value;
+}
