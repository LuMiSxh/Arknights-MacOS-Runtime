             [self changeEditMenuKeyEquivalentsForWindow:[NSApp keyWindow]];
 
-            [NSApp setApplicationIconImage:self.applicationIcon];
+            NSImage* dockIcon = lmisxh_akmocl_dock_identity_enabled() ? lmisxh_akmocl_dock_icon_override() : nil;
+            [NSApp setApplicationIconImage:dockIcon ? dockIcon : self.applicationIcon];
+            [self dockIdentityStart];
         }
     }
 
+    /* Called once the process has a Dock tile. */
+    - (void) dockIdentityStart
+    {
+        static dispatch_once_t once;
+        NSString* name;
+
+        if (!lmisxh_akmocl_dock_identity_enabled()) return;
+
+        dispatch_once(&once, ^{
+            lmisxh_akmocl_dock_exit_done = dispatch_semaphore_create(0);
+            if (atexit( lmisxh_akmocl_leave_dock_at_exit ))
+                WARN(@"could not register the Dock exit handler\n");
+        });
+
+        if ((name = lmisxh_akmocl_dock_name_override()))
+            lmisxh_akmocl_set_dock_name( name );
+    }
+
+    /* The Dock name is the title of the first visible, titled, unowned window. The
+       caller decides whether the window qualifies. */
+    - (void) dockIdentityConsiderWindow:(WineWindow*)window eligible:(BOOL)eligible
+    {
+        if (!lmisxh_akmocl_dock_identity_enabled() || lmisxh_akmocl_dock_name_override()) return;
+
+        if (!lmisxh_akmocl_dock_window)
+        {
+            if (!eligible) return;
+            lmisxh_akmocl_dock_window = window;
+        }
+        if (window == lmisxh_akmocl_dock_window)
+            lmisxh_akmocl_update_dock_name( [window title] );
+    }
+
+    - (void) dockIdentityForgetWindow:(WineWindow*)window
+    {
+        if (window == lmisxh_akmocl_dock_window) lmisxh_akmocl_dock_window = nil;
+    }
+
     - (BOOL) waitUntilQueryDone:(bool*)done timeout:(NSDate*)timeout processEvents:(BOOL)processEvents
     {
         PerformRequest(NULL);
