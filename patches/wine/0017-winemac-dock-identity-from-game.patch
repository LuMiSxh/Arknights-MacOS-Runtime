 static NSString* const NSWindowWillStartDraggingNotification = @"NSWindowWillStartDraggingNotification";
 static NSString* const NSWindowDidEndDraggingNotification = @"NSWindowDidEndDraggingNotification";
 
+/* Dock identity from the game (LMISXH_AKMOCL_DOCK_IDENTITY).
+ * macOS names the Dock tile after the loader binary, which is "wine". Publish the
+ * title of the main window instead. LMISXH_AKMOCL_DOCK_NAME_OVERRIDE fixes the name
+ * and LMISXH_AKMOCL_DOCK_ICON_OVERRIDE names an image file for the icon. At exit the
+ * process leaves the Dock, so macOS records no "wine" entry in the recent apps. */
+#include <dlfcn.h>
+
+static WineWindow* lmisxh_akmocl_dock_window;  /* main thread only; cleared in -dealloc */
+static dispatch_semaphore_t lmisxh_akmocl_dock_exit_done;
+
+static BOOL lmisxh_akmocl_dock_identity_enabled( void )
+{
+    const char *value = getenv( "LMISXH_AKMOCL_DOCK_IDENTITY" );
+
+    return !value || (value[0] == '1' && !value[1]);
+}
+
+static NSString* lmisxh_akmocl_dock_name_override( void )
+{
+    const char *value = getenv( "LMISXH_AKMOCL_DOCK_NAME_OVERRIDE" );
+
+    return value && value[0] ? [NSString stringWithUTF8String:value] : nil;
+}
+
+/* The display name is only reachable through the private LaunchServices call.
+ * Resolve it once and skip the feature when it is missing. */
+static void lmisxh_akmocl_set_dock_name( NSString* name )
+{
+    typedef OSStatus (*set_item_func)( int session, const void *asn, CFStringRef key, CFTypeRef value,
+                                       CFDictionaryRef *info );
+    typedef const void* (*get_asn_func)( void );
+    static set_item_func set_item;
+    static get_asn_func get_asn;
+    static CFStringRef *name_key;
+    static dispatch_once_t once;
+
+    dispatch_once(&once, ^{
+        set_item = (set_item_func)dlsym( RTLD_DEFAULT, "_LSSetApplicationInformationItem" );
+        get_asn = (get_asn_func)dlsym( RTLD_DEFAULT, "_LSGetCurrentApplicationASN" );
+        name_key = (CFStringRef *)dlsym( RTLD_DEFAULT, "_kLSDisplayNameKey" );
+        if (!set_item || !get_asn || !name_key)
+            WARN(@"LaunchServices display name API not found; the Dock keeps the loader name\n");
+    });
+    if (!set_item || !get_asn || !name_key || !*name_key) return;
+
+    /* kLSDefaultSessionID is -2. */
+    set_item( -2, get_asn(), *name_key, name, NULL );
+}
+
+static void lmisxh_akmocl_update_dock_name( NSString* name )
+{
+    if ([name length]) lmisxh_akmocl_set_dock_name( name );
+}
+
+static NSImage* lmisxh_akmocl_dock_icon_override( void )
+{
+    const char *path = getenv( "LMISXH_AKMOCL_DOCK_ICON_OVERRIDE" );
+    NSImage* image;
+
+    if (!path || !path[0]) return nil;
+    image = [[[NSImage alloc] initWithContentsOfFile:[NSString stringWithUTF8String:path]] autorelease];
+    if (!image || ![image isValid])
+    {
+        WARN(@"could not load the Dock icon override %s\n", path);
+        return nil;
+    }
+    return image;
+}
+
+/* Remove the Dock tile before the process ends. The Dock records a tile that is still
+ * present at exit as a recent app. The Wine thread that exits waits at most 250 ms. */
+static void lmisxh_akmocl_leave_dock_at_exit( void )
+{
+    if (!NSApp) return;
+    if (pthread_main_np())
+    {
+        [NSApp setActivationPolicy:NSApplicationActivationPolicyProhibited];
+        return;
+    }
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [NSApp setActivationPolicy:NSApplicationActivationPolicyProhibited];
+        dispatch_semaphore_signal(lmisxh_akmocl_dock_exit_done);
+    });
+    if (dispatch_semaphore_wait(lmisxh_akmocl_dock_exit_done, dispatch_time(DISPATCH_TIME_NOW, 250 * NSEC_PER_MSEC)))
+        WARN(@"timed out leaving the Dock at exit\n");
+}
+
 // Internal distributed notification to handle cooperative app activation in Sonoma.
 static NSString* const WineAppWillActivateNotification = @"WineAppWillActivateNotification";
 static NSString* const WineActivatingAppPIDKey = @"ActivatingAppPID";
