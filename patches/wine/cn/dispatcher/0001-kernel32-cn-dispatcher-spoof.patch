diff --git a/dlls/kernel32/module.c b/dlls/kernel32/module.c
index ac880100..94bc3fcf 100644
--- a/dlls/kernel32/module.c
+++ b/dlls/kernel32/module.c
@@ -261,6 +261,32 @@ BOOL WINAPI GetBinaryTypeA( LPCSTR lpApplicationName, LPDWORD lpBinaryType )
     return GetBinaryTypeW(NtCurrentTeb()->StaticUnicodeString.Buffer, lpBinaryType);
 }
 
+#ifdef __x86_64__
+/* Opt-in only: this dispatcher spoof is for the experimental CN runtime and
+ * must never alter the supported Global/JP/KR process path. */
+static BOOL arknights_runtime_cn_compat_enabled(void)
+{
+    static LONG state = -1;
+    LONG value = state;
+    char flag[2];
+
+    if (value == -1)
+    {
+        value = GetEnvironmentVariableA("ARKNIGHTS_RUNTIME_CN_COMPAT", flag, sizeof(flag)) == 1 && flag[0] == '1';
+        InterlockedCompareExchange(&state, value, -1);
+    }
+    return value;
+}
+
+static void __attribute__((naked)) int3_stub( void )
+{
+    asm("int3\t\n"
+        "int3\t\n"
+        "int3\t\n"
+        "int3\t\n");
+}
+#endif
+
 /***********************************************************************
  *           GetProcAddress   		(KERNEL32.@)
  *
@@ -284,6 +310,15 @@ FARPROC get_proc_address( HMODULE hModule, LPCSTR function )
     {
         ANSI_STRING     str;
 
+#ifdef __x86_64__
+        if (arknights_runtime_cn_compat_enabled() &&
+            (strcmp( function, "KiUserApcDispatcher" ) == 0 || strcmp( function, "KiUserCallbackDispatcher" ) == 0))
+        {
+            FIXME( "HACK: returning int3 stub instead of %s\n", function );
+            return (FARPROC)&int3_stub;
+        }
+#endif
+
         RtlInitAnsiString( &str, function );
         if (!set_ntstatus( LdrGetProcedureAddress( hModule, &str, 0, (void**)&fp ))) return NULL;
     }
