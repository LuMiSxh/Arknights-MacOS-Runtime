+/* The CN compatibility surface is opt-in. Keep the default path byte-for-byte
+ * equivalent to the unpatched Wine behavior for supported regions. */
+static inline BOOL arknights_runtime_cn_compat_enabled(void)
+{
+    static LONG state = -1;
+    LONG value = state;
+    char flag[2];
+
+    if (value == -1)
+    {
+        value = GetEnvironmentVariableA("ARKNIGHTS_RUNTIME_CN_COMPAT", flag, sizeof(flag)) == 1 && flag[0] == '1';
+        InterlockedCompareExchange(&state, value, -1);
+    }
+    return value;
+}
