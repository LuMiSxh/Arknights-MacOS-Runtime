@@ -4419,9 +4632,58 @@ BOOLEAN WINAPI SePrivilegeCheck(PRIVILEGE_SET *privileges, SECURITY_SUBJECT_CONT
  */
 NTSTATUS WINAPI SeLocateProcessImageName(PEPROCESS process, UNICODE_STRING **image_name)
 {
-    FIXME("stub: %p %p\n", process, image_name);
-    if (image_name) *image_name = NULL;
-    return STATUS_NOT_IMPLEMENTED;
+    ULONG len;
+    NTSTATUS status;
+    HANDLE handle, id;
+
+    TRACE("%p %p\n", process, image_name);
+
+    if (!image_name) return STATUS_INVALID_PARAMETER;
+    if (!arknights_runtime_cn_compat_enabled())
+    {
+        *image_name = NULL;
+        return STATUS_NOT_IMPLEMENTED;
+    }
+    *image_name = NULL;
+    id = PsGetProcessId(process);
+
+    if (!(handle = OpenProcess(PROCESS_ALL_ACCESS, FALSE, HandleToUlong(id))))
+        return STATUS_NOT_FOUND;
+
+    len = 0;
+    NtQueryInformationProcess(handle, ProcessImageFileNameWin32, NULL, 0, &len);
+
+    if (!len || len > 32768 - sizeof(WCHAR))
+    {
+        NtClose(handle);
+        return STATUS_BUFFER_TOO_SMALL;
+    }
+    len += sizeof(WCHAR);
+
+    *image_name = ExAllocatePool(PagedPool, len);
+
+    if (!*image_name)
+    {
+        NtClose(handle);
+        return STATUS_NO_MEMORY;
+    }
+
+    (*image_name)->MaximumLength = len;
+
+    if ((status = NtQueryInformationProcess(handle, ProcessImageFileNameWin32,
+                                            *image_name, len - sizeof(WCHAR), &len)))
+    {
+        ExFreePool(*image_name);
+        *image_name = NULL;
+        NtClose(handle);
+        return status;
+    }
+
+    TRACE("ret: %s\n", debugstr_us(*image_name));
+
+    NtClose(handle);
+
+    return STATUS_SUCCESS;
 }
 
