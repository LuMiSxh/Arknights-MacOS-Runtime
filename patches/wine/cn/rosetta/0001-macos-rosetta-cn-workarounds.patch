--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -1826,6 +1826,21 @@ NTSTATUS WINAPI NtCallbackReturn( void *ret_ptr, ULONG ret_len, NTSTATUS status
 }
 
 #ifdef __APPLE__
+/* The additional Rosetta workarounds below are experimental CN compatibility
+ * behavior. Existing CrossOver CET/XGETBV handling remains unchanged. */
+static volatile LONG arknights_runtime_cn_compat;
+
+static BOOL arknights_runtime_cn_compat_enabled(void)
+{
+    return arknights_runtime_cn_compat != 0;
+}
+
+static void arknights_runtime_cn_compat_init(void)
+{
+    const char *flag = getenv("ARKNIGHTS_RUNTIME_CN_COMPAT");
+    InterlockedExchange(&arknights_runtime_cn_compat, flag && flag[0] == '1' && flag[1] == 0);
+}
+
 /***********************************************************************
  *           handle_cet_nop
  *
@@ -1876,6 +1891,34 @@ static inline BOOL handle_cet_nop( ucontext_t *sigcontext, CONTEXT *context )
         if (i == len - 1) return 0;
         switch (instr[i + 1])
         {
+        case 0x1F:
+            /* Rosetta may reject the VMProtect multi-byte NOP (0F 1F /0).
+             * Decode only a real NOP and never advance beyond bytes read. */
+        {
+            unsigned int p = i + 2, mod, rm;
+            BOOL has_sib = FALSE;
+            BYTE modrm, sib;
+
+            if (!arknights_runtime_cn_compat_enabled() || p >= len) return FALSE;
+            modrm = instr[p++];
+            if (modrm & 0x38) return FALSE; /* /0 is the NOP encoding */
+            mod = modrm >> 6;
+            rm = modrm & 7;
+            if (mod != 3 && rm == 4)
+            {
+                if (p >= len) return FALSE;
+                has_sib = TRUE;
+                sib = instr[p++];
+                if (mod == 0 && (sib & 7) == 5) p += 4;
+            }
+            if (mod == 1) p += 1;
+            else if (mod == 2) p += 4;
+            else if (mod == 0 && rm == 5 && !has_sib) p += 4;
+            if (p > len || p > sizeof(instr)) return FALSE;
+            RIP_sig(sigcontext) += p;
+            TRACE_(seh)( "skipped multi-byte NOP (0F 1F)\n" );
+            return TRUE;
+        }
         case 0x1E:
             /* RDSSPD/RDSSPQ: (prefixes) 0F 1E (modrm) */
             RIP_sig(sigcontext) += prefix_count + 3;
@@ -2414,6 +2457,11 @@ static void segv_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
         if (handle_cet_nop( sigcontext, &context.c )) return;
         /* CW HACK 23427 */
         if (emulate_xgetbv( sigcontext, &context.c )) return;
+        /* Rosetta can report ACE's privileged CR3 read as an invalid opcode
+         * rather than a general-protection fault. Preserve Wine's normal
+         * classification unless the experimental CN route is enabled. */
+        if (arknights_runtime_cn_compat_enabled() &&
+            (rec.ExceptionCode = is_privileged_instr( &context.c ))) break;
 #endif
         rec.ExceptionCode = EXCEPTION_ILLEGAL_INSTRUCTION;
         break;
@@ -2987,6 +3035,7 @@ void signal_init_process( TEB *teb )
     signal_alloc_thread( teb );
 
 #ifdef __APPLE__
