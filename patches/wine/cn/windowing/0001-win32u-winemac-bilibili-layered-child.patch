+static BOOL has_bilibili_webview_ancestor( HWND hwnd )
+{
+    static const WCHAR webviewW[] = {'C','M','y','W','e','b','V','i','e','w','D','l','g',0};
+    WCHAR class_name[MAX_ATOM_LEN] = {0};
+    UNICODE_STRING name = {.Buffer = class_name, .MaximumLength = sizeof(class_name)};
+
+    while (hwnd)
+    {
+        if (NtUserGetClassName( hwnd, FALSE, &name ) && !wcscmp( class_name, webviewW )) return TRUE;
+        hwnd = NtUserGetAncestor( hwnd, GA_PARENT );
+    }
+    return FALSE;
+}
+
+static BOOL is_bilibili_payment_proxy_candidate( HWND parent, DWORD style )
+{
+    static const WCHAR browserW[] = {'C','e','f','B','r','o','w','s','e','r','W','i','n','d','o','w',0};
+    static const WCHAR payment_rootW[] = {'C','P','a','y','D','l','g','_','P','_',0};
+    WCHAR parent_class[MAX_ATOM_LEN] = {0}, root_class[MAX_ATOM_LEN] = {0};
+    UNICODE_STRING parent_name = {.Buffer = parent_class, .MaximumLength = sizeof(parent_class)};
+    UNICODE_STRING root_name = {.Buffer = root_class, .MaximumLength = sizeof(root_class)};
+    HWND root;
+    DWORD parent_pid = 0, root_pid = 0, current_pid = GetCurrentProcessId();
+    INT root_length;
+
+    if (!parent || (style & WS_CHILD) == 0 || (style & WS_POPUP)) return FALSE;
+    if (NtUserGetClassName( parent, FALSE, &parent_name ) != ARRAY_SIZE(browserW) - 1 ||
+        wcscmp( parent_class, browserW ))
+        return FALSE;
+
+    /* The pending child is WS_CHILD, so GA_ROOT follows only its parent chain. */
+    if (!(root = NtUserGetAncestor( parent, GA_ROOT )) ||
+        (NtUserGetWindowLongW( root, GWL_STYLE ) & WS_CHILD))
+        return FALSE;
+    if (!(root_length = NtUserGetClassName( root, FALSE, &root_name )) ||
+        root_length <= ARRAY_SIZE(payment_rootW) - 1 ||
+        wcsncmp( root_class, payment_rootW, ARRAY_SIZE(payment_rootW) - 1 ))
+        return FALSE;
+
+    NtUserGetWindowThread( parent, &parent_pid );
+    NtUserGetWindowThread( root, &root_pid );
+    return current_pid && parent_pid == current_pid && root_pid == parent_pid;
+}
+
+static BOOL is_bilibili_layered_proxy_candidate( const UNICODE_STRING *class_name, HWND parent, DWORD style )
+{
+    static const WCHAR platformW[] = {'P','C','G','a','m','e','P','l','a','t','f','o','r','m','.','e','x','e',0};
+    static const WCHAR chrome_widgetW[] = {'C','h','r','o','m','e','_','W','i','d','g','e','t','W','i','n','_','0',0};
+    const WCHAR *path = NtCurrentTeb()->Peb->ProcessParameters->ImagePathName.Buffer;
+    const WCHAR *name, *separator;
+
+    if (!arknights_runtime_cn_compat_enabled() || !path || !class_name || !class_name->Buffer ||
+        class_name->Length != sizeof(chrome_widgetW) - sizeof(WCHAR) ||
+        wcsncmp( class_name->Buffer, chrome_widgetW, ARRAY_SIZE(chrome_widgetW) - 1 ))
+        return FALSE;
+
+    name = path;
+    if ((separator = wcsrchr( name, '\\' ))) name = separator + 1;
+    if ((separator = wcsrchr( name, '/' ))) name = separator + 1;
+    if (wcsicmp( name, platformW )) return FALSE;
+
+    return has_bilibili_webview_ancestor( parent ) || is_bilibili_payment_proxy_candidate( parent, style );
+}
+
+static BOOL is_bilibili_layered_proxy_window( HWND hwnd )
+{
+    /* Chromium's Chrome.WindowTranslucent software-output proxy. */
+    static const WCHAR translucentW[] = {'C','h','r','o','m','e','.','W','i','n','d','o','w','T','r','a','n','s','l','u','c','e','n','t',0};
+    WCHAR class_name[MAX_ATOM_LEN] = {0};
+    UNICODE_STRING name = {.Buffer = class_name, .MaximumLength = sizeof(class_name)};
+    HWND parent = NtUserGetAncestor( hwnd, GA_PARENT );
+    INT length;
+
+    if (!NtUserGetProp( hwnd, translucentW ) ||
+        !(length = NtUserGetClassName( hwnd, FALSE, &name )))
+        return FALSE;
+    name.Length = length * sizeof(WCHAR);
+    return is_bilibili_layered_proxy_candidate( &name, parent, NtUserGetWindowLongW( hwnd, GWL_STYLE ) );
+}
