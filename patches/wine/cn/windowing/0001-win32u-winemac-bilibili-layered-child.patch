+static BOOL arknights_runtime_cn_compat_enabled(void)
+{
+    static LONG state = -1;
+    LONG value = state;
+    const char *flag;
+
+    if (value == -1)
+    {
+        flag = getenv("ARKNIGHTS_RUNTIME_CN_COMPAT");
+        value = flag && flag[0] == '1' && !flag[1];
+        InterlockedCompareExchange(&state, value, -1);
+    }
+    return value;
+}
