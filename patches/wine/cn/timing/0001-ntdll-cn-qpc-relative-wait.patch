+/* The QPC relative-wait variant is enabled by the CN compatibility control.
+ * Keep the upstream wall-clock implementation selected unless explicitly
+ * enabled by the runtime launcher. */
+static BOOL arknights_runtime_cn_compat_enabled(void)
+{
+    static LONG state = -1;
+    LONG value = state;
+    const char *flag;
+
+    if (value == -1)
+    {
+        flag = getenv("ARKNIGHTS_RUNTIME_CN_COMPAT");
+        value = flag && !strcmp(flag, "1");
+        InterlockedCompareExchange(&state, value, -1);
+    }
+    return value;
+}
