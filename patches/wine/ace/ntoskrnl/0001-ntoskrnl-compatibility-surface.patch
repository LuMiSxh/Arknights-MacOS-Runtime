+/* The ACE compact compatibility surface is opt-in. Keep the default path byte-for-byte
+ * equivalent to the unpatched Wine behavior when the control is disabled. */
+static inline BOOL arknights_runtime_ace_compact_enabled(void)
+{
+    static LONG state = -1;
+    LONG value = state;
+    char flag[2];
+
+    if (value == -1)
+    {
+        value = GetEnvironmentVariableA("ARKNIGHTS_RUNTIME_ACE_COMPACT", flag, sizeof(flag)) == 1 && flag[0] == '1';
+        InterlockedCompareExchange(&state, value, -1);
+    }
+    return value;
+}
