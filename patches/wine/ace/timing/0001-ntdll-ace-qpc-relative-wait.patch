+/* The QPC relative-wait variant is enabled by the ACE compatibility control.
+ * Keep the upstream wall-clock implementation selected unless the launcher
+ * enables the master switch and this modifier. */
+static BOOL lmisxh_akmocl_ace_enabled(void)
+{
+    static LONG state = -1;
+    LONG value = state;
+    const char *master, *flag;
+
+    if (value == -1)
+    {
+        master = getenv("LMISXH_AKMOCL");
+        flag = master;
+        value = master && !strcmp(master, "1") && flag && !strcmp(flag, "1");
+        InterlockedCompareExchange(&state, value, -1);
+    }
+    return value;
+}
