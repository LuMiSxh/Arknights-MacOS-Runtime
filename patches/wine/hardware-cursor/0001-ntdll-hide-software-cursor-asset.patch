+static BOOL arknights_runtime_hardware_cursor_enabled(void)
+{
+    static LONG state = -1;
+    LONG enabled = InterlockedCompareExchange( &state, -1, -1 );
+
+    if (enabled == -1)
+    {
+        const char *setting = getenv( "ARKNIGHTS_RUNTIME_HARDWARE_CURSOR" );
+
+        enabled = setting && !strcmp( setting, "1" );
+        if (InterlockedCompareExchange( &state, enabled, -1 ) != -1)
+            enabled = InterlockedCompareExchange( &state, -1, -1 );
+    }
+    return enabled;
+}
