+static void test_hardware_cursor_filter(void)
+{
+    static const char *const names[] =
+    {
+        "a9d41799f1af1868f2db495671227cd4.bin",
+        "A9D41799F1AF1868F2DB495671227CD4.BIN",
+        "prefix-a9d41799f1af1868f2db495671227cd4.bin",
+        "a9d41799f1af1868f2db495671227cd4.bin.extra",
+        "other.bin"
+    };
+    char env[16], dir[MAX_PATH], path[MAX_PATH];
+    DWORD env_len;
+    BOOL enabled;
+    unsigned int i;
+
+    env_len = GetEnvironmentVariableA( "ARKNIGHTS_RUNTIME_HARDWARE_CURSOR", env, sizeof(env) );
+    enabled = env_len == 1 && !strcmp( env, "1" );
+
+    GetTempPathA( MAX_PATH, dir );
+    GetTempFileNameA( dir, "hcf", 0, path );
+    DeleteFileA( path );
+    if (!CreateDirectoryA( path, NULL ))
+    {
+        ok( FALSE, "failed to create temporary directory\n" );
+        return;
+    }
+    lstrcpyA( dir, path );
+
+    for (i = 0; i < ARRAY_SIZE(names); i++)
+    {
+        UNICODE_STRING nameW;
+        OBJECT_ATTRIBUTES attr;
+        IO_STATUS_BLOCK io;
+        HANDLE handle = 0;
+        NTSTATUS status;
+        FILE_BASIC_INFORMATION basic;
+        FILE_NETWORK_OPEN_INFORMATION full;
+        WCHAR pathW[MAX_PATH];
+        BOOL blocked = enabled && i < 2;
+
+        lstrcpyA( path, dir );
+        lstrcatA( path, "\\" );
+        lstrcatA( path, names[i] );
+        MultiByteToWideChar( CP_ACP, 0, path, -1, pathW, ARRAY_SIZE(pathW) );
+        pRtlDosPathNameToNtPathName_U( pathW, &nameW, NULL, NULL );
+        InitializeObjectAttributes( &attr, &nameW, OBJ_CASE_INSENSITIVE, 0, NULL );
+        status = pNtCreateFile( &handle, GENERIC_READ | GENERIC_WRITE, &attr, &io, NULL,
+                                FILE_ATTRIBUTE_NORMAL, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                                FILE_OPEN_IF, 0, NULL, 0 );
+        ok( blocked ? status == STATUS_OBJECT_NAME_NOT_FOUND : status == STATUS_SUCCESS,
+            "%s: expected %s, got %#lx\n", names[i],
+            blocked ? "STATUS_OBJECT_NAME_NOT_FOUND" : "STATUS_SUCCESS", status );
+        if (status == STATUS_SUCCESS)
+        {
+            CloseHandle( handle );
+            status = pNtCreateFile( &handle, GENERIC_READ | GENERIC_WRITE, &attr, &io, NULL,
+                                    FILE_ATTRIBUTE_NORMAL, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                                    FILE_OPEN_IF, 0, NULL, 0 );
+            ok( status == STATUS_SUCCESS, "%s: reopening file failed %#lx\n", names[i], status );
+            if (status == STATUS_SUCCESS) CloseHandle( handle );
+        }
+
+        status = pNtQueryAttributesFile( &attr, &basic );
+        ok( blocked ? status == STATUS_OBJECT_NAME_NOT_FOUND : status == STATUS_SUCCESS,
+            "%s: NtQueryAttributesFile returned %#lx\n", names[i], status );
+        status = pNtQueryFullAttributesFile( &attr, &full );
+        ok( blocked ? status == STATUS_OBJECT_NAME_NOT_FOUND : status == STATUS_SUCCESS,
+            "%s: NtQueryFullAttributesFile returned %#lx\n", names[i], status );
+
+        if (blocked)
+        {
+            DWORD attributes = GetFileAttributesA( path );
+            ok( attributes == INVALID_FILE_ATTRIBUTES && GetLastError() == ERROR_FILE_NOT_FOUND,
+                "%s unexpectedly exists after failed open\n", names[i] );
+        }
+        DeleteFileA( path );
+        pRtlFreeUnicodeString( &nameW );
+    }
+
+    RemoveDirectoryA( dir );
+}
