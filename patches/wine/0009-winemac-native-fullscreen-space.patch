+#define HOUSING_MAX_SCREENS 16
+
+/* The camera housing of all screens.  Only the main thread computes it, from
+   NSScreen, because NSScreen is not safe off the main thread and can lag behind
+   a display change.  Every thread reads the published copy under a lock, so the
+   monitor rectangles, the mode trim and the coordinate flip use the same numbers.
+
+   AppKit reports the housing height in whole points of the current mode, so the
+   share of the screen height differs a little from mode to mode.  The share that
+   counts is the one of the mode that the user had before Wine changed it (the
+   initial display mode of the prefix).  It is latched per display ID and used
+   for every mode, including the current one: the rows of a mode are
+   ceil(share * height of the mode), so they do not depend on the current mode.
+   A display mode that Wine sets never changes the latch.  The latch of a display
+   that leaves the screen list is dropped.  Before a display has a latch, the
+   share of the current mode is in force.
+   Only screens with a nonzero inset are listed. */
+struct housing_insets
+{
+    BOOL valid;                              /* FALSE before the first computation */
+    unsigned serial;                         /* counts the publications */
+    int primary;                             /* rows of the primary screen */
+    int count;
+    CGDirectDisplayID ids[HOUSING_MAX_SCREENS];
+    int insets[HOUSING_MAX_SCREENS];         /* rows in the current mode */
+    double ratios[HOUSING_MAX_SCREENS];      /* share of the height in force */
+    double tops[HOUSING_MAX_SCREENS];        /* what AppKit reports, in points */
+    size_t widths[HOUSING_MAX_SCREENS];      /* size of the current mode, in points */
+    size_t heights[HOUSING_MAX_SCREENS];
+};
+
+struct housing_latch
+{
+    CGDirectDisplayID id;
+    double ratio;
+};
+
+static struct housing_insets published_housing;
+static struct housing_latch housing_latches[HOUSING_MAX_SCREENS];
+static int housing_latch_count;
+static unsigned housing_evaluated_serial;
+static __thread BOOL housing_in_latch_update;
+static os_unfair_lock housing_lock = OS_UNFAIR_LOCK_INIT;
+
+static void update_housing_latch(const struct housing_insets *snapshot);
+
+/***********************************************************************
+ *              macdrv_housing_rows
+ *
+ * The rows that a housing of this share takes from a height.  Round up, so the
+ * trimmed area never overlaps the housing.  The epsilon absorbs float noise, so
+ * a whole number of rows stays whole.
+ */
+int macdrv_housing_rows(double ratio, size_t height)
+{
+    double rows = ceil(ratio * height - 1e-6);
+
+    return rows > 0 && rows < height ? (int)rows : 0;
+}
+
+static void compute_housing_insets(struct housing_insets *out)
+{
+@autoreleasepool
+{
+    NSArray* screens;
+    NSUInteger i, n;
+    CGDirectDisplayID ids[HOUSING_MAX_SCREENS];
+    double tops[HOUSING_MAX_SCREENS];
+    size_t widths[HOUSING_MAX_SCREENS], heights[HOUSING_MAX_SCREENS];
+    int j, k;
+
+    memset(out, 0, sizeof(*out));
+    out->valid = TRUE;
+    if (!native_fullscreen_geometry)
+        return;
+
+    screens = [NSScreen screens];
+    n = MIN([screens count], HOUSING_MAX_SCREENS);
+    for (i = 0; i < n; i++)
+    {
+        CGFloat top = [screens[i] safeAreaInsets].top;
+        NSRect frame = [screens[i] frame];
+
+        ids[i] = [[screens[i] deviceDescription][@"NSScreenNumber"] unsignedIntValue];
+        tops[i] = top > 0 ? top : 0;
+        widths[i] = lround(NSWidth(frame));
+        heights[i] = lround(NSHeight(frame));
+    }
+
+    os_unfair_lock_lock(&housing_lock);
+    /* A display that is gone loses its latch.  When it returns, it is measured again. */
+    for (j = k = 0; j < housing_latch_count; j++)
+    {
+        BOOL present = FALSE;
+
+        for (i = 0; i < n; i++)
+            if (ids[i] == housing_latches[j].id)
+                present = TRUE;
+        if (present)
+            housing_latches[k++] = housing_latches[j];
+    }
+    housing_latch_count = k;
+
+    for (i = 0; i < n; i++)
+    {
+        double ratio = tops[i] > 0 && heights[i] ? tops[i] / heights[i] : 0;
+        int inset;
+
+        if (ratio > 0)
+            for (j = 0; j < housing_latch_count; j++)
+                if (housing_latches[j].id == ids[i])
+                    ratio = housing_latches[j].ratio;
+        inset = ratio > 0 ? macdrv_housing_rows(ratio, heights[i]) : 0;
+
+        if (i == 0)
+            out->primary = inset;
+        if (inset > 0 && out->count < HOUSING_MAX_SCREENS)
+        {
+            k = out->count++;
+            out->ids[k] = ids[i];
+            out->insets[k] = inset;
+            out->ratios[k] = ratio;
+            out->tops[k] = tops[i];
+            out->widths[k] = widths[i];
+            out->heights[k] = heights[i];
+        }
+    }
+    os_unfair_lock_unlock(&housing_lock);
+}
+}
+
+static BOOL housing_insets_equal(const struct housing_insets *a, const struct housing_insets *b)
+{
+    int i;
+
+    if (a->primary != b->primary || a->count != b->count)
+        return FALSE;
+    for (i = 0; i < a->count; i++)
+        if (a->ids[i] != b->ids[i] || a->insets[i] != b->insets[i] || a->ratios[i] != b->ratios[i])
+            return FALSE;
+    return TRUE;
+}
+
+static struct housing_insets get_housing_insets(void)
+{
+    struct housing_insets snapshot;
+    BOOL evaluate;
+
+    os_unfair_lock_lock(&housing_lock);
+    snapshot = published_housing;
+    os_unfair_lock_unlock(&housing_lock);
+
+    if (!snapshot.valid)
+    {
+        /* First query: compute before anything reads the monitors. */
+        OnMainThread(^{
+            [[WineApplicationController sharedController] refreshHousingInset];
+        });
+        os_unfair_lock_lock(&housing_lock);
+        snapshot = published_housing;
+        os_unfair_lock_unlock(&housing_lock);
+    }
+
+    /* The latch needs the initial display mode, which a Wine thread reads from the
+       registry.  The main thread must not, and a nested query from that read
+       sees the unlatched values. */
+    if (snapshot.count && !housing_in_latch_update && ![NSThread isMainThread])
+    {
+        os_unfair_lock_lock(&housing_lock);
+        evaluate = housing_evaluated_serial != snapshot.serial;
+        housing_evaluated_serial = snapshot.serial;
+        os_unfair_lock_unlock(&housing_lock);
+
+        if (evaluate)
+        {
+            housing_in_latch_update = TRUE;
+            update_housing_latch(&snapshot);
+            housing_in_latch_update = FALSE;
+            os_unfair_lock_lock(&housing_lock);
+            snapshot = published_housing;
+            os_unfair_lock_unlock(&housing_lock);
+        }
+    }
+    return snapshot;
+}
 
 
