+/***********************************************************************
+ *              LogMessage
+ */
+void LogMessage(const char* cls, const char* func, NSString* format, ...)
+{
+@autoreleasepool
+{
+    va_list args;
+    va_start(args, format);
+    NSString* message = [[NSString alloc] initWithFormat:format arguments:args];
+    va_end(args);
+    fprintf(stderr, "%s:macdrv:%s:%s", cls, func, [message UTF8String]);
+    [message release];
+}
+}
+
+/***********************************************************************
+ *              macdrv_housing_inset
+ *
+ * Returns the height in whole points of the camera housing of the primary screen.
+ * Safe on any thread: it returns the value that the main thread published.
+ * Wine's desktop starts below it: the monitor, the origin and the display mode
+ * of that screen exclude the housing.  Zero on a screen without a housing and
+ * in a prefix that does not use native fullscreen Spaces.  The gate is not
+ * the one of the windows: every process of a prefix must see the same desktop.
+ */
+CGFloat macdrv_housing_inset(void)
+{
+    if (!native_fullscreen_geometry)
+        return 0;
+    return get_housing_insets().primary;
+}
+
+/***********************************************************************
+ *              macdrv_housing_inset_for_display
+ *
+ * Returns the housing height in whole points of the screen with this display
+ * ID.  A screen other than the primary one only trims its own top rows: Wine's
+ * origin does not move for it, so no point of it needs a conversion.
+ */
+CGFloat macdrv_housing_inset_for_display(CGDirectDisplayID display_id)
+{
+    struct housing_insets snapshot;
+    int i;
+
+    if (!native_fullscreen_geometry)
+        return 0;
+
+    snapshot = get_housing_insets();
+    for (i = 0; i < snapshot.count; i++)
+        if (snapshot.ids[i] == display_id)
+            return snapshot.insets[i];
+    return 0;
+}
+
+/* Wine thread.  Latch the share of every screen that is in the initial display
+   mode of its display.  A screen in a mode that Wine set keeps its latch.  When a
+   latch moved, publish again and tell win32u to read the monitors again. */
+static void update_housing_latch(const struct housing_insets *snapshot)
+{
+    BOOL changed = FALSE;
+    int i, j;
+
+    for (i = 0; i < snapshot->count; i++)
+    {
+        double ratio;
+
+        if (snapshot->tops[i] <= 0 || !snapshot->heights[i] ||
+            !macdrv_display_is_in_original_mode(snapshot->ids[i], snapshot->widths[i], snapshot->heights[i]))
+            continue;
+        ratio = snapshot->tops[i] / snapshot->heights[i];
+
+        os_unfair_lock_lock(&housing_lock);
+        for (j = 0; j < housing_latch_count; j++)
+            if (housing_latches[j].id == snapshot->ids[i])
+                break;
+        if (j < housing_latch_count ? housing_latches[j].ratio != ratio : housing_latch_count < HOUSING_MAX_SCREENS)
+        {
+            housing_latches[j].id = snapshot->ids[i];
+            housing_latches[j].ratio = ratio;
+            if (j == housing_latch_count)
+                housing_latch_count++;
+            changed = TRUE;
+        }
+        os_unfair_lock_unlock(&housing_lock);
+    }
+
+    if (changed)
+        OnMainThread(^{
+            [[WineApplicationController sharedController] refreshHousingInsetAndNotify];
+        });
+}
+
+/***********************************************************************
+ *              macdrv_housing_ratio_for_display
+ *
+ * Returns the share of the screen height that the camera housing takes in the
+ * mode that was current when the main thread published it, unrounded.  The share
+ * is the same in every mode, so a mode height times it gives the housing rows of
+ * that mode without a dependence on the current mode.  Zero without a housing.
+ */
+double macdrv_housing_ratio_for_display(CGDirectDisplayID display_id)
+{
+    struct housing_insets snapshot;
+    int i;
+
+    if (!native_fullscreen_geometry)
+        return 0;
+
+    snapshot = get_housing_insets();
+    for (i = 0; i < snapshot.count; i++)
+        if (snapshot.ids[i] == display_id)
+            return snapshot.ratios[i];
+    return 0;
+}
